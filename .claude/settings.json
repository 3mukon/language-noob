{
  "permissions": {
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/architecture.md)",
      "Edit(/LICENSE)",
      "Edit(/.github/workflows/**)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/.gitleaks.toml)",
      "Edit(/.gitleaksignore)",
      "Edit(/.codex/**)",
      "Edit(/.claude/**)",
      "Edit(/scripts/**)",
      "Edit(/.git/hooks/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(auth.json)",
      "Read(credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/agent-policy.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
